#!/bin/sh
# RFC 3161 over HTTP: one TimeStampReq in, one TimeStampResp out, signed by the bench TSA.
set -eu

PKI_DIR="${NACRE_PKI_STATE:-/run/nacre-pki}"
export PKI_DIR
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

fail() {
  printf 'Status: %s\r\nContent-Type: text/plain\r\n\r\n%s\n' "$1" "$2"
  exit 0
}

[ "${REQUEST_METHOD:-}" = POST ] || fail "405 Method Not Allowed" "POST a TimeStampReq"
length="${CONTENT_LENGTH:-0}"
case "$length" in '' | *[!0-9]*) fail "400 Bad Request" "bad Content-Length" ;; esac
[ "$length" -le 65536 ] || fail "413 Payload Too Large" "request over 64 KiB"

head -c "$length" > "$work/query.tsq"
openssl ts -reply -config "$PKI_DIR/openssl.cnf" -queryfile "$work/query.tsq" \
  -out "$work/reply.tsr" 2> "$work/err" || fail "500 Internal Server Error" "$(cat "$work/err")"

printf 'Content-Type: application/timestamp-reply\r\nContent-Length: %s\r\n\r\n' \
  "$(wc -c < "$work/reply.tsr" | tr -d ' ')"
cat "$work/reply.tsr"
