# Local DSS validator (ADR-0007), pinned to esig/dss-demonstrations 6.5.1.

FROM docker.io/library/maven:3.9.16-eclipse-temurin-26 AS build

ARG DSS_VERSION=6.5.1
ARG DSS_SHA256=ece634c5752bfc2a24806b2eccdd72bd1c01e0cb6bb51fb4ec412db5bd40b840

WORKDIR /build
ADD https://github.com/esig/dss-demonstrations/archive/refs/tags/${DSS_VERSION}.tar.gz dss.tar.gz
RUN echo "${DSS_SHA256}  dss.tar.gz" | sha256sum -c - \
 && tar -xzf dss.tar.gz --strip-components=1 \
 && mvn -B -q package -pl dss-standalone-app,dss-standalone-app-package,dss-demo-webapp -P quick,linux

FROM docker.io/library/tomcat:11.0.27-jre25-temurin

RUN rm -rf /usr/local/tomcat/webapps/*
COPY --from=build /build/dss-demo-webapp/target/dss-demo-webapp-*.war /usr/local/tomcat/webapps/ROOT.war

# The bench runs on the host network: Tomcat listens on 127.0.0.1:18080 only, and its
# shutdown port is closed. The grep fails the build if Tomcat's server.xml moved.
RUN sed -i \
      -e 's|<Server port="8005" shutdown="SHUTDOWN">|<Server port="-1" shutdown="SHUTDOWN">|' \
      -e 's|<Connector port="8080" protocol="HTTP/1.1"|<Connector port="18080" address="127.0.0.1" protocol="HTTP/1.1"|' \
      /usr/local/tomcat/conf/server.xml \
 && grep -q '<Server port="-1"' /usr/local/tomcat/conf/server.xml \
 && grep -q '<Connector port="18080" address="127.0.0.1"' /usr/local/tomcat/conf/server.xml

# Tomcat puts ${catalina.base}/lib on the classpath, where DSS looks for
# dss-custom.properties and the trusted keystore it names.
COPY dss-custom.properties /usr/local/tomcat/lib/dss-custom.properties

EXPOSE 18080
